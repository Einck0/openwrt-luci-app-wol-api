{
  "luci-app-wol-api": {
    "description": "Grant access to WOL API configuration",
    "read": {
      "uci": [ "wol-api" ],
      "file": {
        "/sbin/ip -[46] neigh show": [ "exec" ]
      },
      "ubus": {
        "file": [ "exec" ]
      }
    },
    "write": {
      "uci": [ "wol-api" ]
    }
  }
}
